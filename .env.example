# --- Postgres ---
POSTGRES_USER=blog
POSTGRES_PASSWORD=change_me
POSTGRES_DB=blog
# Uygulama PgBouncer (transaction mode) üzerinden bağlanır
DATABASE_URL=postgresql://blog:change_me@localhost:6432/blog?pgbouncer=true&connection_limit=10
# Migration'lar doğrudan Postgres'e
DIRECT_URL=postgresql://blog:change_me@localhost:5432/blog
# migrate diff için geçici şema veritabanı (her çalıştırmada sıfırlanır)
SHADOW_DATABASE_URL=postgresql://blog:change_me@localhost:5432/blog_shadow

# --- Redis (cache ve kuyruk ayrı instance) ---
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# --- S3 uyumlu depolama (dev: RustFS) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_minio
S3_BUCKET=media
S3_PUBLIC_URL=http://localhost:9000/media

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_32chars__
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_

# --- Uygulama ---
NODE_ENV=development
LOG_LEVEL=debug
DEFAULT_LOCALE=tr
ENABLED_LOCALES=tr,en
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173

# --- Seed ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin!12345
SEED_POSTS_PER_LOCALE=1000
